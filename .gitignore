cat > .gitignore << 'EOF'
# Python
__pycache__/
*.pyc
*.pyo

# Jupyter
.ipynb_checkpoints/

# YOLO cache
*.cache

# Training batch images (large, regenerated)
data/noodles_training/**/train_batch*.jpg
data/noodles_training/**/val_batch*.jpg
data/noodles_training/**/val_batch*.jpg
data/noodles_training/**/predictions/

# Entire datasets and raw data (download/generate fresh)
data/raw/
data/noodles_seg_dataset/
data/noodles_finetune_dataset/
data/yolo_dataset/
data/hdri/
yolo_dataset/

# Blender
*.blend
*.blend1

# Archive (both devices differ, skip entirely)
archive/

# Windows Zone.Identifier
*:Zone.Identifier

# macOS
.DS_Store

# Office temp files
~$*

# IDE
.zencoder/
.zenflow/
.vscode/
.idea/

# Node
node_modules/
webapp-v2/dist/

# Misc
tree_device*.txt
*.bak
runs/
*.zip
*.tar.gz
*.hdr
*.stl
EOF
